{
	"manifest_version": 3,
	"name": "Nostalgia - Notes Manager",
	"version": "1.1.0",
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "public/16.png",
			"32": "public/32.png",
			"48": "public/48.png",
			"192": "public/192.png"
		}
	},
	"description": "Save copied text as notes directly from your clipboard!",
	"icons": {
		"16": "public/16.png",
		"32": "public/32.png",
		"48": "public/48.png",
		"192": "public/192.png"
	},
	"permissions": ["storage", "contextMenus", "clipboardRead", "offscreen"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content-script.js"],
			"run_at": "document_idle"
		}
	],

	"options_page": "options.html",
	"commands": {
		"add_note": {
			"suggested_key": {
				"default": "Ctrl+Shift+E",
				"mac": "Command+E"
			},
			"description": "Save clipboard text as a new note"
		}
	}
}
